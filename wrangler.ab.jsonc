{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakura-dashboard-ab",
  "account_id": "3db21a9be03258f819017ca5c2b055d6",
  "main": "cloudflare/ab-gateway.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ab.sakura.250221.xyz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "AB_SQLITE",
      "database_name": "sakura-dashboard-ab-sqlite",
      "database_id": "b76ca872-f0a3-4b93-8617-f2c2487a1c61"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "COOKIE_SECURE": "true",
    "DATABASE_MODE": "sqlite",
    "SAKURA_ALLOW_SQL_WRITES": "false",
    "SAKURA_DEMO_MODE": "false",
    "AB_STAGE": "schema-only"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
