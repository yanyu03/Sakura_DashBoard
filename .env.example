# Local preview needs no cloud, database or AI credentials.
# These are reference values: set them in your shell, or explicitly load this
# file through your process manager. The preview does not auto-load .env.
PORT=3000
SAKURA_DATA_DIR=.local-data/portfolio

# Worker production configuration is documented in docs/DEPLOYMENT.md.
# TIDB_DATABASE_URL and AUTH_PASSWORD_PEPPERS must be Worker Secrets.
# Never use VITE_ prefixes for database credentials or password protection keys.
# AI services are not configured by the default application.
